{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.bilibili-monitor/schemas/export_record.schema.json",
  "title": "Export Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "platform",
    "exported_at",
    "format",
    "record_count"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.2.0"
    },
    "platform": {
      "type": "string",
      "const": "bilibili"
    },
    "exported_at": {
      "type": "string",
      "format": "date-time"
    },
    "format": {
      "type": "string",
      "enum": ["csv", "json"]
    },
    "record_count": {
      "type": "integer",
      "minimum": 0
    },
    "source_app": {
      "type": ["string", "null"],
      "enum": ["windows", "android", null]
    },
    "source_version": {
      "type": ["string", "null"]
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
