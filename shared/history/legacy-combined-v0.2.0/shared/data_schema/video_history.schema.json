{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.bilibili-monitor/schemas/video_history.schema.json",
  "title": "Video History",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "platform",
    "bv_id",
    "exported_at",
    "snapshots"
  ],
  "properties": {
    "platform": {
      "type": "string",
      "const": "bilibili"
    },
    "bv_id": {
      "type": "string",
      "pattern": "^BV[0-9A-Za-z]{10}$"
    },
    "aid": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "title": {
      "type": ["string", "null"]
    },
    "author_name": {
      "type": ["string", "null"]
    },
    "author_mid": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "source_url": {
      "type": ["string", "null"],
      "format": "uri"
    },
    "exported_at": {
      "type": "string",
      "format": "date-time"
    },
    "snapshots": {
      "type": "array",
      "items": {
        "$ref": "video_snapshot.schema.json"
      }
    }
  }
}
