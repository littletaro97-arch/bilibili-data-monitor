*.local
config.toml
windows/runtime-data/
windows/.venv/

# Historical runtime snapshots and local backups are retained locally, but must
# never enter source control: they can contain databases, logs, exports, and
# app data from real use.
windows/history/local-backups/
windows/history/runtime-snapshots/

# Android local/build artifacts
android/.gradle/
android/local.properties
android/**/build/
android/.idea/
windows/**/__pycache__/
windows/.pytest_cache/

# Release APKs are kept as local deliverables, not Git history.
android/releases/**/*.apk
windows/build/
windows/dist/
windows/packaging/*.spec
windows/releases/**/*.exe
windows/releases/**/*.log
windows/build-installer.log
windows/final-build.log
windows/final-compile.log
